{
  "name": "my-framework/core",
  "description": "A simple custom PHP framework for a test task.",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "doctrine/orm": "^3.6",
    "smarty/smarty": "^5.8",
    "predis/predis": "^3.4",
    "ramsey/uuid-doctrine": "^2.1",
    "doctrine/migrations": "^3.9",
    "doctrine/dbal": "^4.2",
    "symfony/cache": "^6.4",
    "ext-pdo": "*",
    "ext-simplexml": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "doctrine/data-fixtures": "^2.2",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.59"
  },
  "scripts": {
    "db:migrate": "vendor/bin/doctrine-migrations migrations:migrate --no-interaction",
    "db:fixtures": "php bin/app fixtures:load",
    "db:reset": [
      "@db:migrate",
      "@db:fixtures"
    ],
    "cache:warm": "php bin/app cache:warm",
    "cs": "php-cs-fixer fix --allow-risky=yes",
    "test": "vendor/bin/phpunit tests"
  }
}
